PORT=3000
NODE_ENV=development

DATABASE_URL=postgres://postgres:root@localhost:5432/dev4ai

JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# GitHub OAuth Application Configuration  
# Create a GitHub App / OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://127.0.0.1:3000/auth/github/callback

# GitHub token encryption key (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Keep this secret — rotating it invalidates all stored tokens.
GITHUB_TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# GitHub Webhook Secret (HMAC-SHA256 signature verification)
# Must match the Secret configured in your GitHub Repository Webhook settings
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

